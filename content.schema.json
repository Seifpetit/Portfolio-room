{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seif's Room content",
  "type": "object",
  "required": ["schemaVersion", "site", "projects", "cv", "contact"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "site": {
      "type": "object", "additionalProperties": false, "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 160 },
        "previewImage": { "type": "string", "description": "path or URL, 1200x630, empty = none" }
      }
    },
    "projects": {
      "type": "object", "additionalProperties": false, "required": ["intro", "items"],
      "properties": {
        "placeholder": { "type": "boolean", "description": "true shows the purple 'Placeholder content' tag" },
        "intro": { "type": "string", "description": "what Seif says on arrival; \\n = new line" },
        "items": {
          "type": "array", "maxItems": 12,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "name", "description"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "name": { "type": "string", "maxLength": 28 },
              "thumbnail": { "type": "string", "description": "16:9 image path/URL; empty = generated placeholder art" },
              "description": { "type": "string", "maxLength": 80 },
              "tags": { "type": "array", "maxItems": 3, "items": { "type": "string", "maxLength": 14 } },
              "badge": { "type": "string", "maxLength": 10, "description": "Featured, New, Soon... or empty" },
              "cta": {
                "type": "object", "additionalProperties": false, "required": ["label", "url"],
                "properties": { "label": { "type": "string", "maxLength": 14 }, "url": { "type": "string" } }
              },
              "say": { "type": "string", "maxLength": 100, "description": "what Seif says when the card is hovered" },
              "detail": {
                "type": "object", "additionalProperties": false,
                "description": "reserved for the project detail view (not shown yet)",
                "properties": {
                  "summary": { "type": "string", "maxLength": 400 },
                  "role": { "type": "string", "maxLength": 40, "description": "also shown on the card footer" },
                  "stack": { "type": "array", "items": { "type": "string" } },
                  "highlight": { "type": "string", "maxLength": 160 },
                  "gallery": {
                    "type": "array", "maxItems": 4,
                    "items": {
                      "type": "object", "required": ["type", "src"], "additionalProperties": false,
                      "properties": { "type": { "enum": ["image", "video"] }, "src": { "type": "string" }, "alt": { "type": "string" } }
                    }
                  },
                  "links": {
                    "type": "array",
                    "items": { "type": "object", "required": ["label", "url"], "additionalProperties": false, "properties": { "label": { "type": "string" }, "url": { "type": "string" } } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "cv": {
      "type": "object", "additionalProperties": false, "required": ["intro", "name", "role"],
      "properties": {
        "placeholder": { "type": "boolean" },
        "intro": { "type": "string" },
        "photo": { "type": "string", "description": "square image path/URL, empty = silhouette" },
        "name": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "maxLength": 48 },
        "summary": { "type": "string", "maxLength": 240 },
        "experience": {
          "type": "array", "maxItems": 3,
          "items": {
            "type": "object", "required": ["company", "role"], "additionalProperties": false,
            "properties": {
              "company": { "type": "string" }, "role": { "type": "string" }, "start": { "type": "string" }, "end": { "type": "string" },
              "bullets": { "type": "array", "maxItems": 2, "items": { "type": "string", "maxLength": 90 } }
            }
          }
        },
        "education": {
          "type": "array", "maxItems": 2,
          "items": {
            "type": "object", "required": ["school", "degree"], "additionalProperties": false,
            "properties": { "school": { "type": "string" }, "degree": { "type": "string" }, "start": { "type": "string" }, "end": { "type": "string" } }
          }
        },
        "skills": {
          "type": "array", "maxItems": 3,
          "items": { "type": "object", "required": ["items"], "additionalProperties": false, "properties": { "group": { "type": "string" }, "items": { "type": "array", "items": { "type": "string" } } } }
        },
        "languages": { "type": "array", "items": { "type": "string" } },
        "pdf": { "type": "string", "description": "path/URL of the CV PDF; empty hides the Download button" }
      }
    },
    "contact": {
      "type": "object", "additionalProperties": false, "required": ["intro", "links"],
      "properties": {
        "placeholder": { "type": "boolean" },
        "intro": { "type": "string" },
        "links": {
          "type": "array", "minItems": 1, "maxItems": 6,
          "items": {
            "type": "object", "required": ["id", "label", "url"], "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string", "maxLength": 14 },
              "url": { "type": "string", "description": "https://..., mailto:..., or tel:..." },
              "icon": { "type": "string", "description": "linkedin | github | gmail | link (default)" },
              "iconImage": { "type": "string", "description": "optional 24x24 pixel PNG, used when icon is not a built-in one" }
            }
          }
        }
      }
    }
  }
}
